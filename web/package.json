{
  "name": "fluidither",
  "version": "0.2.0",
  "type": "module",
  "description": "Dithered, spring-driven web components with no runtime dependencies",
  "license": "MIT",
  "author": "vrnrn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrnrn/fluidither.git",
    "directory": "web"
  },
  "homepage": "https://fluidither.vrnrn.com",
  "bugs": {
    "url": "https://github.com/vrnrn/fluidither/issues"
  },
  "keywords": [
    "dither",
    "ui",
    "components",
    "web-components",
    "no-framework",
    "strict-csp",
    "springs"
  ],
  "bin": {
    "fluidither": "bin/fluidither.mjs"
  },
  "files": [
    "src",
    "bin",
    "skill"
  ],
  "scripts": {
    "prepack": "rm -rf skill && cp -R ../skills/fluidither skill"
  },
  "sideEffects": true,
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./components/*": "./src/components/*",
    "./core/*": "./src/core/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
