{
  "$comment": "The single source of design tokens. Run `npm run tokens` after editing. Never edit the generated files in web/src and gpui/src/generated.rs.",
  "springs": {
    "quick": { "duration": 0.09, "damping": 1 },
    "glide": { "duration": 0.18, "damping": 1 },
    "settle": { "duration": 0.3, "damping": 0.9 }
  },
  "sizes": {
    "regular": { "control": 34, "segment": 28, "inset": 3, "pad": 14, "tabPad": 11, "gap": 6, "icon": 15, "fontSize": 13, "lineHeight": 18 },
    "compact": { "control": 26, "segment": 22, "inset": 2, "pad": 10, "tabPad": 8, "gap": 4, "icon": 13, "fontSize": 12, "lineHeight": 16 }
  },
  "radii": { "control": 6, "pill": 5 },
  "weights": { "regular": 400, "strong": 560 },
  "font": { "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif" },
  "themes": {
    "light": {
      "paper": "#F6F5F1",
      "ink": "#1B1A17",
      "wash": "#ECEAE4",
      "inkSoft": "#5F5C54",
      "line": "#D6D3CA",
      "edge": "#8F8B80",
      "focus": "#2F5FE0",
      "solidHover": "#35332E",
      "solidPress": "#4A4840",
      "onSolid": "#F6F5F1",
      "soft": "#1B1A1712",
      "softHover": "#1B1A171F",
      "press": "#1B1A1714",
      "shadow": "#1B1A1726",
      "screen": "#1B1A1742"
    },
    "dark": {
      "paper": "#131311",
      "ink": "#F3F1EA",
      "wash": "#24231F",
      "inkSoft": "#A8A498",
      "line": "#F3F1EA29",
      "edge": "#6E6B62",
      "focus": "#7FA0FF",
      "solidHover": "#DEDCD4",
      "solidPress": "#C6C3BA",
      "onSolid": "#131311",
      "soft": "#F3F1EA1F",
      "softHover": "#F3F1EA30",
      "press": "#F3F1EA24",
      "shadow": "#00000066",
      "screen": "#00000080"
    }
  },
  "surfaces": {
    "light": ["#F6F5F1", "#FBFAF7", "#FFFFFF", "#FFFFFF"],
    "dark": ["#131311", "#1C1B18", "#2B2A25", "#35342E"],
    "shadow": [[0, 0], [1, 3], [4, 14], [12, 36]]
  },
  "palette": {
    "$comment": "Every hue uses one lightness and chroma per theme, so the colors stay balanced.",
    "lightness": { "light": 0.56, "dark": 0.78 },
    "chroma": 0.15,
    "hues": { "red": 25, "orange": 60, "green": 148, "blue": 240, "violet": 300, "pink": 350 }
  },
  "glyphs": {
    "$comment": "Pixel marks drawn from 2px cells, so checks look the same on both targets.",
    "tick": [".....#", "....##", "#..##.", "####..", ".##..."],
    "dash": ["######"],
    "arrow": ["#####", ".###.", "..#.."],
    "arrowUp": ["..#..", ".###.", "#####"]
  },
  "dither": { "cell": 3, "fps": 30, "hoverCell": 2, "hoverInk": 0.18 }
}
